# Copy to .env and set real values. Never commit .env.
DB_NAME=dominion
DB_USER=dominion
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Host ports published by docker-compose (MySQL is internal only).
WEB_PORT=8080
API_PORT=3000
SIM_PORT=8000

# First-run admin setup: choose a random secret of at least 16 characters, start the stack,
# then open /setup.html and enter it. Setup is disabled when this is empty.
# Generate one with: openssl rand -base64 24
SETUP_TOKEN=

# Session cookies are marked Secure by default, which requires HTTPS (http://localhost also works).
# Set to false only when serving plain HTTP on a trusted LAN address.
COOKIE_SECURE=true
